# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Required for saving interface settings in the cloud
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-side only Supabase service role key (optional, for administrative operations bypass)
SUPABASE_SERVICE_ROLE_KEY=""

# STRICT CORS CONFIGURATION: Comma-separated list of additional allowed origin domains
ALLOWED_ORIGINS="https://tastvng-2027.vercel.app"

# SMTP MAIL SERVER CREDENTIALS: Required for sending system and registration confirmation emails securely
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SENDER_NAME="Inscripcions El Tast"

# RESEND API CONFIGURATION: Required for sending emails via Resend
RESEND_API_KEY=""

# META GRAPH API CONFIGURATION: Required for Instagram and Facebook official notices sync
# App ID and App Secret from Meta for Developers (Graph API v19.0)
META_APP_ID=""
META_APP_SECRET=""
# OAuth Redirect URI configured in Meta Developers App (defaults to /api/social?action=callback)
META_REDIRECT_URI="https://tastvng-2027.vercel.app/api/social?action=callback"
# Secret key used for AES-256-GCM token vault encryption (must be private in Vercel environment)
META_ENCRYPTION_KEY=""



